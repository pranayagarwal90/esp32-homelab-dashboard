# Homelab Dashboard backend configuration.
#
#   cp .env.example .env    # then edit .env (it is git-ignored)
#
# Process environment variables (e.g. systemd Environment=) override this file.
# Format: KEY=value, one per line; # starts a comment. Values are taken
# literally (optional matching quotes); nothing is expanded or executed.
# Blank core settings use the default; blank integrations are disabled.

# --- Server -------------------------------------------------------------------
DASHBOARD_BIND=0.0.0.0
DASHBOARD_PORT=8090
# IANA timezone for the clock, calendar, weather and sunrise/sunset.
DASHBOARD_TIMEZONE=UTC
# Host name shown when the host metrics agent does not report one.
DASHBOARD_HOST_LABEL=Server
# Relative paths are resolved from the project root (this file's directory).
DASHBOARD_PHOTOS_DIR=./photos-ready
# Extra clocks: Label=Area/City, comma separated; blank = none.
# The current firmware shows only India, Singapore and London (labels must
# match); fully configurable clocks need a later firmware update.
DASHBOARD_WORLD_CLOCKS=London=Europe/London,Tokyo=Asia/Tokyo

# --- Weather (Open-Meteo, no API key) ----------------------------------------------
# Both blank = weather disabled. Decimal degrees, e.g. 51.51 and -0.13.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=

# --- Host metrics (windows-agent/host-metrics-agent.ps1) ----------------------------
# Blank = disabled. Example: http://192.0.2.10:9183/
HOST_METRICS_URL=

# --- Docker -----------------------------------------------------------------------
# Lists containers (docker ps) and, for listed services without a health URL,
# reports a service up when a running container name matches it.
DOCKER_STATUS_ENABLED=true

# --- Services -----------------------------------------------------------------------
# Services shown/monitored by the dashboard, comma separated. Blank disables all
# service monitoring. Known ids: jellyfin, navidrome, metube, bazarr, ollama,
# cloudflare, mcp, nextcloud, immich, technical_blog. An unknown id stops startup.
# Example: SERVICES=jellyfin,navidrome,ollama,immich
SERVICES=

# Health check per listed service: an HTTP(S) URL. Blank = up when a running
# Docker container name matches (jellyfin, navidrome, metube, bazarr, ollama,
# cloudflare, mcp; needs DOCKER_STATUS_ENABLED=true), otherwise down.
# Unlisted services are never checked and never shown as offline.
SERVICE_JELLYFIN_HEALTH_URL=
SERVICE_NAVIDROME_HEALTH_URL=
SERVICE_METUBE_HEALTH_URL=
SERVICE_OLLAMA_HEALTH_URL=
SERVICE_CLOUDFLARE_HEALTH_URL=
SERVICE_NEXTCLOUD_HEALTH_URL=
SERVICE_IMMICH_HEALTH_URL=
SERVICE_TECHNICAL_BLOG_HEALTH_URL=
SERVICE_BAZARR_HEALTH_URL=
SERVICE_MCP_HEALTH_URL=

# --- AI assistant (local Ollama) ------------------------------------------------------
# Optional primary engine (e.g. a GPU machine); blank = fallback only.
AI_PRIMARY_OLLAMA_URL=
AI_PRIMARY_OLLAMA_MODEL=qwen2.5:7b
AI_FALLBACK_OLLAMA_URL=http://127.0.0.1:11434
AI_FALLBACK_OLLAMA_MODEL=llama3.2:3b
